{$DOMAIN}, www.{$DOMAIN} {
    encode gzip

    request_body {
        max_size 25MB
    }

    handle_path /static/* {
        root * /srv/static
        file_server
    }

    handle_path /media/* {
        root * /srv/media
        file_server
    }

    handle /mcp* {
        reverse_proxy mcp:8001
    }

    reverse_proxy web:8000
}
