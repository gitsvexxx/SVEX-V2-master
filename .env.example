# Public deployment settings
DOMAIN=example.com
DEBUG=False
ALLOWED_HOSTS=example.com,www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
SECRET_KEY=replace-with-a-long-random-secret
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# PostgreSQL
POSTGRES_DB=svex
POSTGRES_USER=svex
POSTGRES_PASSWORD=replace-with-a-long-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# MCP database tools: keep these secrets outside Git.
# READ_TOKEN can inspect data; WRITE_TOKEN can also propose/confirm updates.
SVEX_MCP_READ_TOKEN=replace-with-a-long-random-read-token
SVEX_MCP_WRITE_TOKEN=replace-with-a-different-long-random-write-token
MCP_LOG_LEVEL=INFO

# Optional SMTP settings for password-reset emails
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
